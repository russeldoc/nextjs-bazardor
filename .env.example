# Auth (Better Auth)
BETTER_AUTH_SECRET=replace-with-a-random-string-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB (Atlas or local). Needed so accounts survive restarts / deployment.
MONGODB_URI=
MONGODB_DATABASE=bazardor

# Product API (assignment API)
BAZARDOR_API_URL=https://openapi.programming-hero.com/api/bazardor

# Social login (optional; buttons need valid credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
