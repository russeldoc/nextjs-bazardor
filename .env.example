# Better Auth: use a long random secret in production
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Atlas or local MongoDB connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.oknheww.mongodb.net/?appName=Cluster0
MONGODB_DATABASE=bazardor

# OAuth credentials (optional until you enable the buttons)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The API supplied with the assignment
BAZARDOR_API_URL=https://api.api-store.workers.dev/api/bazardor